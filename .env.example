# Project paths
LEGAL_RAG_DATA_DIR=data
LEGAL_RAG_RAW_DIR=data/raw
LEGAL_RAG_PROCESSED_DIR=data/processed
LEGAL_RAG_OUTPUT_DIR=data/outputs

# Model/runtime defaults. Values are examples, not secrets.
LEGAL_RAG_EMBEDDING_MODEL=darklethelong/vnlegal-lal
LEGAL_RAG_GENERATOR_MODEL=Qwen/Qwen2.5-7B-Instruct
LEGAL_RAG_LLM_BASE_URL=http://localhost:8000/v1

# Service endpoints for later phases. Replace locally as needed.
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_PORT=9200
OPENSEARCH_PERFORMANCE_ANALYZER_PORT=9600
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_rag
POSTGRES_USER=legal_rag
POSTGRES_PASSWORD=change-me
